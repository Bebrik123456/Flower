<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Flower.EmployeeWindow"
        Title="EmployeeWindow"
        MinHeight="600"
        MinWidth="800">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        
        <Grid Grid.Row ="0">
            
            <StackPanel Orientation="Horizontal" Margin="0 10 0 0 "  HorizontalAlignment="Center" Spacing="20" >
                <ComboBox MinWidth="150">
                   <ComboBoxItem> Адрес один </ComboBoxItem>
                    <ComboBoxItem> Адрес два </ComboBoxItem>
                    <ComboBoxItem> Адрес три </ComboBoxItem>
                </ComboBox>
                
                <ComboBox MinWidth="150" >
                    <ComboBoxItem> Готов </ComboBoxItem>
                    <ComboBoxItem> Не готов </ComboBoxItem>
                </ComboBox>
                
                <Button Background="#FF6C5CE7" 
                        Foreground="White" 
                        HorizontalAlignment="Center" 
                        Content="Обновить" />
                
            </StackPanel>
        </Grid>
        
        <Grid Grid.Row="1">
            <ListBox Name="OrdersListBox" SelectionChanged="OrdersListBox_OnSelectionChanged" />
        </Grid>
        
    </Grid>
</Window>
